<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/bubbleIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bubble_background"
        android:src="@drawable/ic_stat_trace"
        android:padding="8dp" />

    <LinearLayout
        android:id="@+id/panelContainer"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MOVE MODE" />

        <Button
            android:id="@+id/btnToggleLock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unlocked" />

        <Button
            android:id="@+id/btnToggleContrast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="High Contrast" />

        <Button
            android:id="@+id/btnToggleInvert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Invert Colors" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Opacity"
            android:textColor="#FFFFFF"
            android:layout_marginTop="8dp" />

        <SeekBar
            android:id="@+id/seekBarOpacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btnCloseService"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close Overlay"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</LinearLayout>
